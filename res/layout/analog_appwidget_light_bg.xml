<!-- "Light background" variant of the analog clock widget, inflated by the host when the Launcher
     decides the wallpaper supports dark (black) workspace icon labels. The dial and hands are
     white images, so they are tinted with the same black the Launcher uses for its labels.
     Must keep the same view ids as analog_appwidget.xml. -->

<AnalogClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analog_appwidget"
    android:dial="@drawable/appwidget_clock_dial"
    android:dialTint="@android:color/black"
    android:hand_hour="@drawable/appwidget_clock_hour"
    android:hand_hourTint="@android:color/black"
    android:hand_minute="@drawable/appwidget_clock_minute"
    android:hand_minuteTint="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
